{
  "name": "dsh-connect-godagent",
  "version": "0.1.0",
  "description": "把本机登录的 God Agent 桌面 App（gptgod.online）模型接入 DSH：复用其会话凭据自动创建/复用 API Key，注册 OpenAI 兼容模型目录，展示分组倍率。",
  "type": "module",
  "main": "lib/index.js",
  "platform": "web",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "remote",
        "remote.settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/cordis-plugin-loader": ">=1.1.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.2-rc.1",
    "@earendil-works/pi-ai": ">=1.5.2",
    "@deepseek-ai/schemastery": ">=3.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atorber/dsh-connect-godagent.git"
  },
  "homepage": "https://github.com/atorber/dsh-connect-godagent#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "gptgod",
    "god-agent"
  ]
}
